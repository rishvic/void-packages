# Template file for 'slstatus'
pkgname=slstatus
version=1.1
revision=1
build_style=gnu-makefile
short_desc="Suckless status monitor for dwm"
maintainer="Dom H. <dom@hxy.io>"
license="ISC"
homepage="https://tools.suckless.org/slstatus/"
distfiles="https://dl.suckless.org/tools/slstatus-${version}.tar.gz"
makedepends="alsa-lib-devel libX11-devel"
checksum=7dc7140de5de61fc551c4e0feb6410afd44d78e0cdcaee45d06e5701f34eac14

pre_build() {
	[ -e ${FILESDIR}/config.h ] && cp ${FILESDIR}/config.h config.h
	sed -i -e 's|^CFLAGS *=|override CFLAGS +=|g' \
		-e 's|^LDFLAGS *=|override LDFLAGS +=|g' config.mk
}

post_install() {
	vlicense LICENSE
	vdoc "${FILESDIR}/README.voidlinux"
}
