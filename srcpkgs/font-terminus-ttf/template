# Template file for 'font-terminus-ttf'
pkgname=font-terminus-ttf
version=4.49.3
revision=1
depends="font-util"
short_desc="A TrueType version of Terminus Font"
maintainer="Rishvic Pushpakaran <rishvic@gmail.com>"
license="OFL-1.1"
homepage="https://files.ax86.net/terminus-ttf/"
distfiles="https://files.ax86.net/terminus-ttf/files/${version}/terminus-ttf-${version}.zip"
checksum=0ead921d98d99a4590ffe6cd66dc037fc0a2ceea1c735d866ba73fe058257577
font_dirs="/usr/share/fonts/TTF/terminus"
provides="font:monospace-0_1"

do_install() {
	vmkdir usr/share/fonts/TTF/terminus
	for font_file in "${wrksrc}"/*.ttf; do
		vinstall "${font_file}" 644 usr/share/fonts/TTF/terminus/
	done
	vlicense COPYING
}
